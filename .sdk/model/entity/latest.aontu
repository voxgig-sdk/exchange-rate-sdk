# Entity: latest

main: kit: entity: latest: {

  alias: field: {}

  fields: {
    base: {
      h: "Base"
      n: "base"
      r: false
      sh: "The currency code you supplied as base in your request"
      t: "`$STRING`"
    }
    date: {
      h: "Date"
      n: "date"
      r: false
      sh: "The date these exchange rates are for"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    rates: {
      h: "Rates"
      n: "rates"
      r: false
      sh: "Each supported currency code in terms of the base currency"
      t: "`$OBJECT`"
    }
    time_last_updated: {
      h: "Time Last Updated"
      n: "time_last_updated"
      r: false
      sh: "The epoch time this set of exchange rates was generated"
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "latest"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /latest/{base_currency}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "base_currency"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/latest/{base_currency}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              base_currency: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "latest"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
